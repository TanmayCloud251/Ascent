# ============================================================================
# Ascent AI Coding Academy — Environment Configuration (.env.example)
# ============================================================================

# MongoDB Connection String (e.g. MongoDB Atlas or local mongod)
MONGODB_URI=mongodb://localhost:27017/ascent

# GitHub OAuth App Credentials (Classic OAuth App with 'repo, read:user, user:email' scope)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Session Cookie Secret (Used for signed HTTP cookies)
SESSION_SECRET=replace_with_a_long_cryptographically_secure_random_string_32_chars_min

# Token Encryption Key for AES-256-GCM (Hex or high-entropy passphrase, min 32 chars)
TOKEN_ENCRYPTION_KEY=replace_with_a_secure_token_encryption_key_at_least_32_characters

# Application Base URL (Used for OAuth redirect URIs and CORS validation)
APP_URL=http://localhost:3000

# Optional Server Port (Defaults to 3000)
PORT=3000

# Gemini Model Selection (Optional, defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite
